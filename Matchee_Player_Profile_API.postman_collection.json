	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save tokens from login response",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    const responseJson = pm.response.json();",
					"    ",
					"    if (responseJson.accessToken) {",
					"        pm.environment.set('access_token', responseJson.accessToken);",
					"    }",
					"    ",
					"    if (responseJson.refreshToken) {",
					"        pm.environment.set('refresh_token', responseJson.refreshToken);",
					"    }",
					"    ",
					"    // Save player profile ID if available",
					"    if (responseJson.id) {",
					"        pm.environment.set('player_profile_id', responseJson.id);",
					"    }",
					"    ",
					"    // Save user ID if available",
					"    if (responseJson.userId) {",
					"        pm.environment.set('user_id', responseJson.userId);",
					"    }",
					"}",
					"",
					"// Log response for debugging",
					"console.log('Response:', pm.response.text());"
				]
			}
		}
