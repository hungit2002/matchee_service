		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save tokens and IDs from responses with new format",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    const responseJson = pm.response.json();",
					"    ",
					"    // Check if response has new format",
					"    if (responseJson.status === 'success' && responseJson.data) {",
					"        const data = responseJson.data;",
					"        ",
					"        // Save authentication tokens",
					"        if (data.accessToken) {",
					"            pm.environment.set('access_token', data.accessToken);",
					"        }",
					"        ",
					"        if (data.refreshToken) {",
					"            pm.environment.set('refresh_token', data.refreshToken);",
					"        }",
					"        ",
					"        // Save user information",
					"        if (data.userId) {",
					"            pm.environment.set('user_id', data.userId);",
					"        }",
					"        ",
					"        if (data.id && pm.request.url.path.includes('player/profile')) {",
					"            pm.environment.set('player_profile_id', data.id);",
					"        }",
					"        ",
					"        // Save venue ID if available",
					"        if (data.id && pm.request.url.path.includes('venues') && !pm.request.url.path.includes('courts') && !pm.request.url.path.includes('slots')) {",
					"            pm.environment.set('venue_id', data.id);",
					"        }",
					"        ",
					"        // Save court ID if available",
					"        if (data.id && pm.request.url.path.includes('courts') && !pm.request.url.path.includes('slots')) {",
					"            pm.environment.set('court_id', data.id);",
					"        }",
					"        ",
					"        // Save slot ID if available",
					"        if (data.id && pm.request.url.path.includes('slots')) {",
					"            pm.environment.set('slot_id', data.id);",
					"        }",
					"        ",
					"        // Save user info from user object",
					"        if (data.user) {",
					"            if (data.user.id) {",
					"                pm.environment.set('user_id', data.user.id);",
					"            }",
					"            if (data.user.fullName) {",
					"                pm.environment.set('user_full_name', data.user.fullName);",
					"            }",
					"            if (data.user.phone) {",
					"                pm.environment.set('user_phone', data.user.phone);",
					"            }",
					"            if (data.user.email) {",
					"                pm.environment.set('user_email', data.user.email);",
					"            }",
					"        }",
					"    } else {",
					"        // Fallback for old format",
					"        if (responseJson.accessToken) {",
					"            pm.environment.set('access_token', responseJson.accessToken);",
					"        }",
					"        ",
					"        if (responseJson.refreshToken) {",
					"            pm.environment.set('refresh_token', responseJson.refreshToken);",
					"        }",
					"        ",
					"        if (responseJson.userId) {",
					"            pm.environment.set('user_id', responseJson.userId);",
					"        }",
					"        ",
					"        if (responseJson.id && pm.request.url.path.includes('player/profile')) {",
					"            pm.environment.set('player_profile_id', responseJson.id);",
					"        }",
					"    }",
					"}",
					"",
					"// Log response for debugging",
					"console.log('Response Status:', pm.response.code);",
					"console.log('Response Body:', pm.response.text());",
					"",
					"// Validate new response format",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    const responseJson = pm.response.json();",
					"    ",
					"    if (responseJson.status && responseJson.code && responseJson.message) {",
					"        console.log('✅ New response format detected');",
					"        ",
					"        if (responseJson.status === 'success') {",
					"            console.log('✅ Success response');",
					"        } else if (responseJson.status === 'fail') {",
					"            console.log('❌ Error response:', responseJson.message);",
					"        }",
					"    } else {",
					"        console.log('⚠️ Old response format detected');",
					"    }",
					"}"
				]
			}
		}
